# Isi dengan nilai yang berbeda dan simpan .env secara privat.
JADWAL_DB_PASSWORD=
JADWAL_DB_ROOT_PASSWORD=
JADWAL_ADMIN_EMAIL=
JADWAL_ADMIN_PASSWORD=

# Port untuk uji di host Docker.
JADWAL_HTTP_PORT=8093
# Ubah menjadi 1 saat aplikasi dibuka melalui HTTPS Cloudflare.
JADWAL_COOKIE_SECURE=0
CLOUDFLARE_TUNNEL_TOKEN=
